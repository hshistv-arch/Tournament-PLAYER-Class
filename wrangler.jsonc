// Cloudflare Workers の設定。Workers名は Cloudflare 上の既存のWorkers「tournament-player-class」と同じ。
// 画面(index.html・assets/)は静的アセットとして配信し、/api/* だけをWorkers(worker/index.js)が処理する。
// データ保存先は KV(CLUB_KV)。KVの id を省くと、デプロイ時に自動で作成される(Wrangler 4.45以降)。
// 自動作成されない場合は、ダッシュボードの Storage & Databases → KV で名前空間を作り、その id を下に書く。
{
  "name": "tournament-player-class",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "CLUB_KV" }
  ]
}
